# Exception: the pinned recorder ({{ lookup('config', application_id, 'services.recorder.version') }})
# declares its task queue as transient and non-exclusive. RabbitMQ 4 refuses
# that by default and answers the declare with an AMQP hard error, so the
# recorder can never consume and retries forever. Permitting the deprecated
# feature keeps the queue working until the recorder moves off the rabbitmq
# transport; see the version pin in meta/services.yml.
deprecated_features.permit.transient_nonexcl_queues = true
