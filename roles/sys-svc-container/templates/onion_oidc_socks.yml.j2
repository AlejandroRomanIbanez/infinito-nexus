{% set _oidc_onion_host = lookup('tls', 'web-app-keycloak', 'domain') %}
{% set _oidc_onion_addr = 'host-gateway' if (compose_mode_force | default('') or DEPLOYMENT_MODE) == 'compose' else ansible_facts['default_ipv4']['address'] %}
{% if (lookup('config', application_id, 'services.sso.enabled') | bool) and (_oidc_onion_host is search('\.onion$')) %}
    extra_hosts:
      - "host.docker.internal:host-gateway"
      - "{{ _oidc_onion_host }}:{{ _oidc_onion_addr }}"
{% endif %}
