{% if compose_mode == 'swarm' %}
{{ "\n" }}
{% set _deploy = {
  'application_id': application_id,
  'service': service_name | default(''),
  'sizing_application_id': service_sizing_application_id | default(application_id),
  'applications': lookup('applications'),
  'db_instance': db_instance,
  'seeded_after_converge': db_instance and lookup('config', application_id, 'services.' ~ service_name ~ '.ha.seeded_after_converge', false),
  'replicas_forced': service_replicas_forced | default(none),
  'max_replicas_per_node': service_max_replicas_per_node | default(none),
  'db_endpoint': service_db_endpoint is defined,
  'manager_placed': application_id in lookup('roles_with_placement', 'manager'),
  'managers': groups['svc-swarm-manager'] | default([]),
  'kata_group': groups['svc-virt-kata'] is defined,
  'kata_enabled': groups['svc-virt-kata'] is defined and (lookup('config', application_id, 'services.kata.enabled', false) | bool),
  'update_parallelism': service_update_parallelism | default(1),
  'update_delay': service_update_delay | default('10s'),
  'update_order': service_update_order | default(none),
  'restart_policy': docker_restart_policy | default(DOCKER_RESTART_POLICY),
  'runtime': RUNTIME,
  'seed_wait_label': SWARM_SERVICE_LABEL_SEED_WAIT,
  'db_endpoint_label': SWARM_SERVICE_LABEL_DB_ENDPOINT,
  'host_id_label': SWARM_NODE_LABEL_HOST_ID,
  'stack_host_label': SWARM_NODE_LABEL_STACK_HOST,
  'sandbox_label': SANDBOX_NODE_LABEL,
  'defaults': {
    'cpus': RESOURCE_CPUS,
    'host_cpus': RESOURCE_HOST_CPUS,
    'mem_limit': RESOURCE_MEM_LIMIT,
    'pids_limit': RESOURCE_PIDS_LIMIT,
    'mem_reservation': RESOURCE_MEM_RESERVATION,
  },
} %}
{% set _replicas = _deploy | swarm_deploy_replicas %}
{{ _deploy | swarm_deploy(lookup('compose_replicas', _replicas) if _replicas != '' else lookup('compose_replicas')) }}
{% endif %}
