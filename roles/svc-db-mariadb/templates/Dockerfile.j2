ARG MARIADB_IMAGE
ARG MARIADB_VERSION
FROM ${MARIADB_IMAGE}:${MARIADB_VERSION}
{% if MARIADB_HA | bool %}

RUN rm -rf /var/lib/apt/lists/* \
 && apt-get -o Acquire::Retries=3 update \
 && apt-get -o Acquire::Retries=3 install -y --no-install-recommends python3 tini \
 && rm -rf /var/lib/apt/lists/*

COPY {{ MARIADB_HA_CONTEXT_DIR }}/infinito_elector /opt/db-elector/infinito_elector
COPY {{ MARIADB_HA_CONTEXT_DIR }}/seed_relay.py /opt/infinito/seed_relay.py
COPY {{ MARIADB_HA_CONTEXT_DIR }}/ha_entrypoint.sh /usr/local/bin/infinito-ha-entrypoint.sh
RUN chmod 0755 /usr/local/bin/infinito-ha-entrypoint.sh

ENV PYTHONPATH=/opt/db-elector

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/infinito-ha-entrypoint.sh"]
CMD ["mariadbd"]
{% endif %}
