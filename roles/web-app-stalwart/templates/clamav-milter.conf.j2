# Bridges Stalwart's DATA-stage milter (inet) to the local clamd. The
# clamav/clamav image's clamd listens on /tmp/clamd.sock by default.
MilterSocket inet:{{ STALWART_CLAMAV_MILTER_PORT }}
MilterSocketMode 660
ClamdSocket unix:/tmp/clamd.sock
OnInfected Reject
OnClean Accept
# Exception: this fails OPEN — while clamd is unavailable or still warming up
# (freshclam), mail is accepted unscanned rather than deferred, because a starting
# scanner must not block delivery.
OnFail Accept
AddHeader Replace
LogSyslog no
LogInfected Basic
Foreground yes
