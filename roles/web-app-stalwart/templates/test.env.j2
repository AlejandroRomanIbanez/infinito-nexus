{# Exception: this file is sourced by bash, so values take the shell `quote` filter —
   `dotenv_quote` passes values through unquoted in swarm mode and breaks on secrets. #}
ADMIN_EMAIL={{ lookup('users', 'administrator').email | quote }}

ADMIN_IMAP_PASSWORD={{ lookup('users', 'administrator').password | quote }}

BIBER_EMAIL={{ lookup('users', 'biber').email | quote }}

BIBER_IMAP_PASSWORD={{ lookup('users', 'biber').password | quote }}

MAILU_MAILDIR_VOLUME={{ lookup('volume', 'web-app-mailu', 'dovecot_mail').name | quote }}

MAILU_SMTP_CONTAINER={{ lookup('config', 'web-app-mailu', 'services.smtp.name') | quote }}

MAIL_DOMAIN={{ STALWART_DOMAIN | quote }}

{# Exception: addressed, not staged — test-e2e-cli copies only files/test/, and the
   migration script is role code shared with tasks/12_import_mailu.yml. #}
MIGRATION_SCRIPT={{ lookup('path_absolute', 'roles', application_id, 'files/python/migrate_from_mailu.py') | quote }}

{# Exception: the migration script imports nothing outside the stdlib, but the bare
   ansible_python_interpreter may be older than the project floor — prefer the venv. #}
PYTHON_BIN={{ (lookup('env', 'PYTHON') or '/opt/venvs/infinito/bin/python') | quote }}

{# Exception: the harness stores mail in the legacy provider and migrates it in place —
   only when this role is the deploy target (not a pulled-in mail provider), on the stack
   host, in compose mode (the import is compose-only; see tasks/manager_ops.yml). #}
STALWART_MIGRATION_E2E={{ ((application_id in PRIMARY_APPS) and ('web-app-mailu' in group_names) and DEPLOYMENT_MODE == 'compose' and IS_STACK_HOST | bool) | string | lower }}
