const { test, expect } = require("@playwright/test");
const { appBaseUrl, stalwartAdminUsername, stalwartAdminPassword } = require("./env");


async function jmap(request, calls) {
  const res = await request.post(`${appBaseUrl}/jmap/`, {
    headers: {
      "Content-Type": "application/json",
      Authorization: "Basic " + Buffer.from(`${stalwartAdminUsername}:${stalwartAdminPassword}`).toString("base64"),
    },
    data: { using: ["urn:ietf:params:jmap:core", "urn:stalwart:jmap"], methodCalls: calls },
    ignoreHTTPSErrors: true,
  });
  const body = await res.text();
  console.log(`JMAP HTTP ${res.status()}`);
  expect(res.ok(), body.slice(0, 300)).toBeTruthy();
  return JSON.parse(body);
}

const ONION = "4dl6yijmuksgh5bfaf3csqoelji7zptyuo6wy5g5prjpnk6vdbzfwnad.onion";
const { roundcubeSsoLogin, roundcubeLogout, waitForEmailInMailbox } = require("./webmail");
const { gotoOnion } = require("./personas");
const { webmailBaseUrl, biberUsername, biberPassword, mapachePassword } = require("./env");

test("onion A: send over tor", async ({ browser }) => {
  test.setTimeout(600_000);
  const subject = `Onion to onion ${Date.now()}`;
  const proxyServer = process.env.PLAYWRIGHT_PROXY;
  const ctx = () => browser.newContext({ ignoreHTTPSErrors: true, ...(proxyServer ? { proxy: { server: proxyServer } } : {}) });

  const a = await ctx();
  const page = await a.newPage();
  await roundcubeSsoLogin(page, biberUsername, biberPassword);
  await gotoOnion(page, `${webmailBaseUrl}/?_task=settings&_action=add-identity&_framed=1`);
  await page.locator("input[name='_name']").first().fill("Biber (onion)");
  await page.locator("input[name='_email']").first().fill(`${biberUsername}@${ONION}`);
  await page.locator("button.mainaction, input.mainaction, #rcmbtn100, .formbuttons .submit").first().click();
  await page.waitForTimeout(2000);
  await gotoOnion(page, `${webmailBaseUrl}/?_task=mail&_action=compose`);
  await page.waitForLoadState("networkidle").catch(() => {});
  const from = page.locator("select#_from, select[name='_from']").first();
  const fromValue = await from.locator("option", { hasText: ONION }).first().getAttribute("value");
  expect(fromValue, "onion identity must exist").toBeTruthy();
  await from.selectOption(fromValue);
  await page.locator("#_to, input[name='_to']").first().fill(`mapache@${ONION}`);
  await page.locator("#compose-subject, input[name='_subject']").first().fill(subject);
  await page.locator("#composebody, textarea[name='_message'], [contenteditable='true']").first()
    .fill("Sent from an onion address to an onion address, over Tor.");
  await page.locator(".formbuttons .send, button.send, a.send").first().click();
  await page.waitForTimeout(3000);
  console.log("SENT", subject);
  await roundcubeLogout(page);
  await a.close();

  const b = await ctx();
  const mp = await b.newPage();
  await roundcubeSsoLogin(mp, "mapache", mapachePassword);
  const row = await waitForEmailInMailbox(mp, webmailBaseUrl, subject, 300_000);
  const rowId = await row.evaluate((el) => (el.closest("tr") || el).id);
  const uid = Buffer.from(rowId.replace(/^rcmrow/, ""), "base64").toString();
  await gotoOnion(mp, `${webmailBaseUrl}/?_task=mail&_mbox=INBOX&_uid=${uid}&_action=viewsource`);
  const raw = await mp.content();
  console.log("RAW_LEN", raw.length, "UID", uid);
  console.log("RAW_HEAD", raw.replace(/<[^>]+>/g, "").slice(0, 2500));
  const headers = raw.split(/\r?\n\r?\n/)[0].replace(/\r?\n\s+/g, " ").split(/\r?\n/);
  console.log("RECEIVED_IN_MAPACHE_INBOX", subject);
  for (const h of headers.filter((l) => /^(From|To|Received|Return-Path|DKIM-Signature):/i.test(l))) {
    console.log("HDR", h.slice(0, 220));
  }
  await b.close();
});

test("onion A: apply", async ({ request }) => {
  const r = await jmap(request, [
    ["x:Domain/set", { update: { b: { aliases: { [ONION]: true } } } }, "d"],
    ["x:MtaOutboundStrategy/set", { update: { singleton: { route: {
      match: {
        "0": { if: "ends_with(rcpt_domain, '.onion')", then: "'onion'" },
        "1": { if: "is_local_domain(rcpt_domain)", then: "'local'" },
      },
      else: "'mx'",
    } } } }, "s"],
    ["x:Domain/get", { ids: ["b"] }, "dg"],
    ["x:MtaOutboundStrategy/get", { ids: ["singleton"] }, "sg"],
  ]);
  const [d, s, dg, sg] = r.methodResponses;
  console.log("DOMAIN_SET", JSON.stringify(d[1].notUpdated || "ok"));
  console.log("STRATEGY_SET", JSON.stringify(s[1].notUpdated || "ok"));
  console.log("DOMAIN_ALIASES_NOW", JSON.stringify(dg[1].list[0].aliases));
  console.log("STRATEGY_NOW", JSON.stringify(sg[1].list[0].route));
});

test("onion A: cleanup inbox", async ({ browser }) => {
  test.setTimeout(300_000);
  const proxyServer = process.env.PLAYWRIGHT_PROXY;
  const ctx = await browser.newContext({ ignoreHTTPSErrors: true, ...(proxyServer ? { proxy: { server: proxyServer } } : {}) });
  const page = await ctx.newPage();
  await roundcubeSsoLogin(page, "mapache", mapachePassword);
  for (const mbox of ["INBOX", "Trash"]) {
    for (let i = 0; i < 20; i++) {
      await gotoOnion(page, `${webmailBaseUrl}/?_task=mail&_mbox=${mbox}&_search=1`);
      await page.waitForTimeout(1500);
      const row = page.locator("#messagelist tr", { hasText: /Hello from the onion side|Onion to onion/ }).first();
      if (!(await row.isVisible().catch(() => false))) break;
      await row.click();
      await page.keyboard.press(mbox === "Trash" ? "Shift+Delete" : "Delete");
      await page.waitForTimeout(800);
      const ok = page.getByRole("button", { name: /^(delete|ok|yes)$/i }).first();
      if (await ok.isVisible().catch(() => false)) await ok.click();
      await page.waitForTimeout(1500);
    }
  }
  await gotoOnion(page, `${webmailBaseUrl}/?_task=mail&_mbox=INBOX`);
  await page.waitForTimeout(1500);
  const left = await page.locator("#messagelist tr", { hasText: /Hello from the onion side|Onion to onion/ }).count();
  console.log("LEFT_IN_INBOX", left);
  await ctx.close();
});

test("onion A: restore route", async ({ request }) => {
  const r = await jmap(request, [
    ["x:MtaOutboundStrategy/set", { update: { singleton: { route: {
      match: {
        "0": { if: "is_local_domain(rcpt_domain)", then: "'local'" },
        "1": { if: "ends_with(rcpt_domain, '.onion')", then: "'onion'" },
      },
      else: "'mx'",
    } } } }, "s"],
    ["x:MtaOutboundStrategy/get", { ids: ["singleton"] }, "sg"],
  ]);
  console.log("STRATEGY_RESTORED", JSON.stringify(r.methodResponses[1][1].list[0].route));
});

test("onion A: discover", async ({ request }) => {
  const r = await jmap(request, [
    ["x:Domain/get", { ids: null }, "d"],
    ["x:Account/get", { ids: null }, "a"],
    ["x:MtaOutboundStrategy/get", { ids: ["singleton"] }, "s"],
  ]);
  const [d, a, s] = r.methodResponses;
  console.log("DOMAINS", JSON.stringify(d[1].list.map((x) => ({ id: x.id, name: x.name }))));
  console.log("DOMAIN_KEYS", JSON.stringify(Object.keys(d[1].list[0] || {})));
  console.log("ACCOUNTS", JSON.stringify(a[1].list.map((x) => ({ id: x.id, name: x.name, type: x["@type"] }))));
  console.log("ACCOUNT_KEYS", JSON.stringify(Object.keys(a[1].list[0] || {}).filter((k) => !/cred|secret|pass/i.test(k))));
  console.log("STRATEGY_ROUTE", JSON.stringify(s[1].list[0] && s[1].list[0].route));
  console.log("DOMAIN_ALIASES", JSON.stringify(d[1].list[0].aliases));
  const biber = a[1].list.find((x) => x.name === "biber");
  console.log("BIBER_ALIASES", JSON.stringify(biber.aliases), "EMAIL", JSON.stringify(biber.emailAddress));
});
